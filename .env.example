# z.ai API Configuration (Primary - Claude/GLM)
NUXT_ZAI_API_KEY=your-zai-api-key-here
NUXT_ZAI_API_BASE=https://api.z.ai/api/anthropic
NUXT_PRIMARY_MODEL=claude-3-5-sonnet-20241022
NUXT_PRIMARY_MODEL_DISPLAY_NAME="Claude 3.5 Sonnet"

# OpenRouter Configuration (Fallback - Gemini/Others)
NUXT_OPENROUTER_API_KEY=your-openrouter-api-key-here
NUXT_OPENROUTER_API_BASE=https://openrouter.ai/api/v1
NUXT_FALLBACK_MODEL=inclusionai/ring-2.6-1t:free

# Database Configuration
NUXT_DATABASE_PATH=./data/app.db

# Session Configuration
NUXT_SESSION_SECRET=your-session-secret-here-change-in-production

# Application Configuration
NUXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# CORS Configuration (comma-separated origins)
NUXT_CORS_ORIGINS=http://localhost:3000
